# Nemotron 3 Ultra + OpenCode Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# =============================================================================
# REQUIRED: NVIDIA API Key (get free key at https://build.nvidia.com)
# =============================================================================
NVIDIA_API_KEY=nvapi-your-key-here

# =============================================================================
# OPTIONAL: Fallback API (OpenRouter free tier)
# =============================================================================
# OPENROUTER_API_KEY=sk-or-your-key-here

# =============================================================================
# DOCKER COMPOSE SETTINGS (for self-hosted deployment)
# =============================================================================
# Path to Nemotron 3 Ultra NVFP4 model checkpoint on host
# MODEL_PATH=/mnt/models/nemotron-3-ultra

# Grafana admin password (REQUIRED - no default for security)
GRAFANA_PASSWORD=your-secure-password-here

# Kong API Gateway consumer keys (generate secure random strings)
CONSUMER_API_KEY=nemotron-user-key-change-me
ADMIN_API_KEY=nemotron-admin-key-change-me

# =============================================================================
# CACHE SETTINGS
# =============================================================================
# Cache TTL in hours (default: 24)
CACHE_TTL_HOURS=24

# =============================================================================
# MONITORING (optional)
# =============================================================================
# Prometheus remote write credentials (for long-term storage)
# PROM_USER=prometheus
# PROM_PASS=your-password

# =============================================================================
# TLS/SSL (for production)
# =============================================================================
# Path to certificate and key files for Kong
# SSL_CERT_PATH=/etc/kong/certs/server.crt
# SSL_KEY_PATH=/etc/kong/certs/server.key